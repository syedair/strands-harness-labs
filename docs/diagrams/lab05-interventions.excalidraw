   "text": "from strands.vended_interventions.hitl import HumanInTheLoop  # NEW\nfrom strands_harness import create_harness, resolve_interventions  # NEW\n\nif sys.argv[1:] == [\"policy\"]:\n    # Part B: a plain-English rule.\n    interventions = resolve_interventions(\n        \"Reading and fetching are fine. Writing files is only fine under ./trips.\",\n        ask=\"stdio\",\n    )\nelse:\n    # Part A: approve every tool call in the terminal.\n    interventions = HumanInTheLoop(ask=\"stdio\")\n\nagent = create_harness(\n    model=MAIN_MODEL,\n    instructions=INSTRUCTIONS,\n    builtin_tools=[\"web_fetch\", \"write\"],\n    session=False,\n    memory=False,\n    skills=True,\n    interventions=interventions,  # NEW\n)",
   "originalText": "from strands.vended_interventions.hitl import HumanInTheLoop  # NEW\nfrom strands_harness import create_harness, resolve_interventions  # NEW\n\nif sys.argv[1:] == [\"policy\"]:\n    # Part B: a plain-English rule.\n    interventions = resolve_interventions(\n        \"Reading and fetching are fine. Writing files is only fine under ./trips.\",\n        ask=\"stdio\",\n    )\nelse:\n    # Part A: approve every tool call in the terminal.\n    interventions = HumanInTheLoop(ask=\"stdio\")\n\nagent = create_harness(\n    model=MAIN_MODEL,\n    instructions=INSTRUCTIONS,\n    builtin_tools=[\"web_fetch\", \"write\"],\n    session=False,\n    memory=False,\n    skills=True,\n    interventions=interventions,  # NEW\n)",
