  {
   "id": "lab06-system1-basics-59-e6a016",
   "type": "text",
   "x": 1548.0,
   "y": 410.0,
   "width": 762.890625,
   "height": 297.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
