   "text": "from strands.interventions import Guide, InterventionHandler, Proceed\n\nclass CompletionCheck(InterventionHandler):\n    name = \"system1-completion-check\"  # unique per agent\n    MAX_GUIDES = 2  # Guide makes the model retry: cap it\n\n    def after_model_call(self, event):  # runs when the model finishes a reply\n        answer = text_of(event.stop_response.message)  # the draft\n        p = yes_no_many(request_state(turns, answer), QUESTIONS)  # 1. System 1 observes...\n        if p[\"answered_everything\"] >= self.PASS or self.guides >= self.MAX_GUIDES:  # 2. ...Python decides\n            return Proceed()  # the draft is accepted\n        self.guides += 1\n        return Guide(feedback=FEEDBACK)  # the draft is discarded; the model tries again",
   "originalText": "from strands.interventions import Guide, InterventionHandler, Proceed\n\nclass CompletionCheck(InterventionHandler):\n    name = \"system1-completion-check\"  # unique per agent\n    MAX_GUIDES = 2  # Guide makes the model retry: cap it\n\n    def after_model_call(self, event):  # runs when the model finishes a reply\n        answer = text_of(event.stop_response.message)  # the draft\n        p = yes_no_many(request_state(turns, answer), QUESTIONS)  # 1. System 1 observes...\n        if p[\"answered_everything\"] >= self.PASS or self.guides >= self.MAX_GUIDES:  # 2. ...Python decides\n            return Proceed()  # the draft is accepted\n        self.guides += 1\n        return Guide(feedback=FEEDBACK)  # the draft is discarded; the model tries again",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 13
  },
