# Main agent (the harness). Default: Kimi K2.5 on Amazon Bedrock — needs AWS credentials.
MAIN_MODEL=bedrock/moonshotai.kimi-k2.5
# Alternatives (uncomment one):
# MAIN_MODEL=bedrock/nvidia.nemotron-super-3-120b      # cheapest clean option
# MAIN_MODEL=bedrock/us.anthropic.claude-sonnet-5      # Claude
# MAIN_MODEL=bedrock/us.moonshotai.kimi-k3             # latest Kimi, pricier
# MAIN_MODEL=ollama/gpt-oss:20b                        # free, fully local

# System 1 classifier used by labs 6-9 (lab 10 compares all four).
SYSTEM1_MODEL=ollama/qwen3.5:4b   # free, local stand-in (default); ollama/qwen3.5:9b is more accurate
# SYSTEM1_MODEL=jev               # TypeSafe's hosted System 1 model — set TYPESAFE_API_KEY below
# SYSTEM1_MODEL=kev               # open Jev-alike on your machine — start its server (README), set KEV_URL
# SYSTEM1_MODEL=laya              # open, BERT-based — run: uv sync --extra laya

# Lab 9 routes easy requests to SMALL_MODEL and hard ones to BIG_MODEL.
SMALL_MODEL=bedrock/moonshotai.kimi-k2.5
BIG_MODEL=bedrock/us.moonshotai.kimi-k3
# Fully local: SMALL_MODEL=ollama/qwen3.5:9b  BIG_MODEL=ollama/gpt-oss:20b

OLLAMA_HOST=http://127.0.0.1:11434

# Jev and Kev settings (for SYSTEM1_MODEL=jev/kev, and lab 10).
TYPESAFE_API_KEY=
KEV_URL=http://127.0.0.1:8009

# Lab 10b: who labels the training data (kev or jev). Without one it uses data/lab10b-labels.json.
TEACHER=kev
AWS_REGION=us-east-1
