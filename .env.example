# Main agent (the harness). Default: Kimi K2.5 on Amazon Bedrock — needs AWS credentials.
MAIN_MODEL=bedrock/moonshotai.kimi-k2.5
# Alternatives (uncomment one):
# MAIN_MODEL=bedrock/nvidia.nemotron-super-3-120b      # cheapest clean option
# MAIN_MODEL=bedrock/us.anthropic.claude-sonnet-5      # Claude
# MAIN_MODEL=bedrock/us.moonshotai.kimi-k3             # latest Kimi, pricier
# MAIN_MODEL=ollama/gpt-oss:20b                        # free, fully local

# System 1 classifier (always local on Ollama). qwen3.5:9b is more accurate, slower.
SYSTEM1_MODEL=qwen3.5:4b

# Lab 9 routes easy requests to SMALL_MODEL and hard ones to BIG_MODEL.
SMALL_MODEL=bedrock/moonshotai.kimi-k2.5
BIG_MODEL=bedrock/us.moonshotai.kimi-k3

OLLAMA_HOST=http://127.0.0.1:11434
AWS_REGION=us-east-1
